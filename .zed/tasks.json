    "command": "bun",
    "args": ["run", "typecheck"],
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always"
  },
  {
    "label": "Lint",
    "command": "bun",
    "args": ["run", "lint"],
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always"
  },
  {
    "label": "Format",
