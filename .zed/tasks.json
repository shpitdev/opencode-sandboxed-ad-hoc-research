[
  {
    "label": "Start OpenCode Daytona",
    "command": "bun",
    "args": ["run", "start"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Analyze URLs (example.md)",
    "command": "bun",
    "args": ["run", "analyze", "--", "--input", "example.md"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Biome Check",
    "command": "bun",
